{
  "name": "trackar-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "register-vehicle": "node lib/scripts/registerVehicle.js",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-trackar --config ../../firebase.json 'vitest run'",
    "set-admin": "node lib/scripts/setAdmin.js",
    "set-server-config": "node lib/scripts/setServerConfig.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "firebase-tools": "^15.34.1"
  }
}
