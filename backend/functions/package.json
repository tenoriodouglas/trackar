{
  "name": "trackar-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "register-vehicle": "node lib/scripts/registerVehicle.js",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-trackar --config ../../firebase.json 'vitest run'"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "firebase-tools": "^15.34.1"
  }
}
