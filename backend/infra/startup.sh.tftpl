#!/bin/bash
# Runs on every boot: installs Docker once, renders Traccar config with the secret, (re)starts the container.
set -euo pipefail

# 1 GB swap keeps the small VM stable under memory spikes.
if [ ! -f /swapfile ]; then
  fallocate -l 1G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
swapon /swapfile 2>/dev/null || true

if ! command -v docker >/dev/null; then
  apt-get update
  apt-get install -y docker.io
  systemctl enable --now docker
fi

TOKEN=$(gcloud secrets versions access latest --secret="${secret_name}")
mkdir -p /opt/traccar/data /opt/traccar/logs
umask 077
cat > /opt/traccar/traccar.xml <<XML
<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>
    <!-- Devices are created on first contact; ownership is managed in Firestore. -->
    <entry key='database.registerUnknown'>true</entry>
    <!-- Admin UI bound to localhost: use the IAP tunnel (terraform output traccar_ui_tunnel). -->
    <entry key='web.address'>127.0.0.1</entry>
    <entry key='web.port'>8082</entry>
    <entry key='forward.enable'>true</entry>
    <entry key='forward.type'>json</entry>
    <entry key='forward.json'>true</entry>
    <entry key='forward.url'>${ingest_url}</entry>
    <entry key='forward.header'>Authorization: Bearer $TOKEN</entry>
    <entry key='forward.retry.enable'>true</entry>
    <entry key='forward.retry.limit'>1000</entry>
    <entry key='logger.file'>./logs/tracker-server.log</entry>
</properties>
XML

# Admin account the bridge uses on localhost (also valid for the Traccar UI through the IAP tunnel).
ADMIN_PASSWORD=$(gcloud secrets versions access latest --secret="${admin_secret}")

docker pull "${traccar_image}"
docker rm -f traccar >/dev/null 2>&1 || true
docker run -d --name traccar --restart unless-stopped --network host \
  --log-opt max-size=10m --log-opt max-file=3 \
  -e JAVA_TOOL_OPTIONS="-Xms128m -Xmx${heap_mb}m" \
  -v /opt/traccar/data:/opt/traccar/data \
  -v /opt/traccar/logs:/opt/traccar/logs \
  -v /opt/traccar/traccar.xml:/opt/traccar/conf/traccar.xml:ro \
  "${traccar_image}"

# ---------- Command bridge (Firestore -> Traccar) ----------
gcloud auth configure-docker "${registry_host}" --quiet >/dev/null 2>&1 || true
mkdir -p /opt/trackar
cat > /opt/trackar/bridge.env <<ENV
TRACCAR_URL=http://127.0.0.1:8082
TRACCAR_EMAIL=bridge@trackar.local
TRACCAR_PASSWORD=$ADMIN_PASSWORD
ENV
chmod 600 /opt/trackar/bridge.env

# Pulls the latest bridge image and restarts the container only when it changed. Run at boot and every 5 min,
# so a CI push is live within minutes without SSH access from CI.
cat > /opt/trackar/update-bridge.sh <<'SCRIPT'
#!/bin/bash
set -uo pipefail
IMAGE="${bridge_image}"
docker pull -q "$IMAGE" >/dev/null 2>&1 || exit 0
NEW=$(docker image inspect -f '{{.Id}}' "$IMAGE")
CURRENT=$(docker inspect -f '{{.Image}}' trackar-bridge 2>/dev/null || true)
if [ "$NEW" != "$CURRENT" ]; then
  docker rm -f trackar-bridge >/dev/null 2>&1 || true
  docker run -d --name trackar-bridge --restart unless-stopped --network host \
    --memory 192m --log-opt max-size=10m --log-opt max-file=3 \
    --env-file /opt/trackar/bridge.env "$IMAGE"
  docker image prune -f >/dev/null 2>&1 || true
fi
SCRIPT
chmod 700 /opt/trackar/update-bridge.sh
echo '*/5 * * * * root /opt/trackar/update-bridge.sh' > /etc/cron.d/trackar-bridge
# Force a restart so a rotated password is picked up.
docker rm -f trackar-bridge >/dev/null 2>&1 || true
/opt/trackar/update-bridge.sh
