rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vehicles are written only by the device gateway (Admin SDK bypasses rules).
    // Users can read only vehicles they own.
    match /vehicles/{vehicleId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.ownerIds;
      allow write: if false;

      // History: readable by the owners of the parent vehicle.
      match /positions/{positionId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.ownerIds;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
