rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Set with `npm run set-admin` / the "Set admin" workflow.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsVehicle(vehicleId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.ownerIds;
    }

    // All writes go through the gateway or callable functions (Admin SDK bypasses rules).
    match /vehicles/{vehicleId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.ownerIds);
      allow write: if false;

      match /positions/{positionId} {
        allow read: if isAdmin() || ownsVehicle(vehicleId);
        allow write: if false;
      }

      match /commands/{commandId} {
        allow read: if isAdmin() || ownsVehicle(vehicleId);
        allow write: if false;
      }
    }

    // Gateway facts (tracker IP) for the admin panel.
    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
